# Plantilla completa. Para un servidor nuevo usa .env.server.example.
COMPOSE_PROJECT_NAME=alea
ALEA_ROOT=/docker/alea
NODE_ENV=production
TZ=America/Mexico_City

# Acceso provisional por IP. Sustituye IP_DEL_SERVIDOR antes de arrancar.
APP_PROTOCOL=http
APP_HOST=IP_DEL_SERVIDOR
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3001
BASE_PATH=
API_BASE_PATH=/api
# Docker Compose expande estas URL a partir de protocolo, host, puerto y paths.
PUBLIC_FRONTEND_URL=${APP_PROTOCOL}://${APP_HOST}:${FRONTEND_PORT}${BASE_PATH}
PUBLIC_BACKEND_URL=${APP_PROTOCOL}://${APP_HOST}:${FRONTEND_PORT}${API_BASE_PATH}
API_BASE_URL=${PUBLIC_BACKEND_URL}
BACKEND_INTERNAL_URL=http://backend:3001

TRUST_PROXY=false
CORS_ORIGINS=${APP_PROTOCOL}://${APP_HOST}:${FRONTEND_PORT}
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_NAME=alea_refresh_token

DATABASE_NAME=alea
DATABASE_USER=alea
DATABASE_PASSWORD=CAMBIAR_POR_UN_VALOR_SEGURO
DB_RUN_MIGRATIONS=true
DB_SYNCHRONIZE=false

JWT_ACCESS_SECRET=CAMBIAR_POR_UN_VALOR_SEGURO_DE_AL_MENOS_32_CARACTERES
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_VALOR_SEGURO_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP es opcional cuando MAIL_REQUIRED=false.
MAIL_REQUIRED=false
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=20000

# Solo se usa si la tabla users esta vacia en el primer arranque.
SEED_ADMIN_EMAIL=admin@CAMBIAR_DOMINIO
SEED_ADMIN_PASSWORD=CAMBIAR_POR_UN_VALOR_SEGURO
SEED_ADMIN_FULLNAME=Administrador Inicial
SEED_ADMIN_INSTITUTION=
SEED_ADMIN_INSTITUTION_ACRONYM=
SEED_ADMIN_POSITION=

LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
