# Ejemplo futuro: Nginx del host + HTTPS + dos paths aun pendientes.
COMPOSE_PROJECT_NAME=alea
ALEA_ROOT=/docker/alea
NODE_ENV=production
TZ=America/Mexico_City

APP_PROTOCOL=https
APP_HOST=alea.sesna.gob.mx
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3001

BASE_PATH=/RUTA_FRONTEND
API_BASE_PATH=/RUTA_BACKEND
# Docker Compose expande estas URL a partir de protocolo, host y paths.
PUBLIC_FRONTEND_URL=${APP_PROTOCOL}://${APP_HOST}${BASE_PATH}
PUBLIC_BACKEND_URL=${APP_PROTOCOL}://${APP_HOST}${API_BASE_PATH}
API_BASE_URL=${PUBLIC_BACKEND_URL}
BACKEND_INTERNAL_URL=http://backend:3001

TRUST_PROXY=true
CORS_ORIGINS=${APP_PROTOCOL}://${APP_HOST}
COOKIE_SECURE=true
COOKIE_DOMAIN=${APP_HOST}
COOKIE_NAME=alea_refresh_token

DATABASE_NAME=alea
DATABASE_USER=alea
DATABASE_PASSWORD=CAMBIAR_POR_UN_VALOR_SEGURO
DB_RUN_MIGRATIONS=true
DB_SYNCHRONIZE=false

JWT_ACCESS_SECRET=CAMBIAR_POR_UN_VALOR_SEGURO_DE_AL_MENOS_32_CARACTERES
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_VALOR_SEGURO_DE_AL_MENOS_32_CARACTERES
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

MAIL_REQUIRED=true
MAIL_HOST=smtp.CAMBIAR_PROVEEDOR
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=CAMBIAR_USUARIO_SMTP
MAIL_PASS=CAMBIAR_PASSWORD_SMTP
MAIL_FROM=Muestreo Simple <no-reply@sesna.gob.mx>
MAIL_CONNECTION_TIMEOUT_MS=10000
MAIL_GREETING_TIMEOUT_MS=10000
MAIL_SOCKET_TIMEOUT_MS=20000

SEED_ADMIN_EMAIL=admin@sesna.gob.mx
SEED_ADMIN_PASSWORD=CAMBIAR_POR_UN_VALOR_SEGURO
SEED_ADMIN_FULLNAME=Administrador Inicial
SEED_ADMIN_INSTITUTION=
SEED_ADMIN_INSTITUTION_ACRONYM=
SEED_ADMIN_POSITION=

LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
